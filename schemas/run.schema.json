{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/tsumego-bench/run.schema.json",
  "title": "Tsumego Bench model run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "createdAt",
    "benchmark",
    "model",
    "harness",
    "condition",
    "artifacts"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 3 },
    "status": {
      "enum": [
        "prepared",
        "running",
        "evaluating",
        "completed",
        "harness_failed",
        "evaluation_failed"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitSha",
        "promptSha256",
        "referenceManifestSha256",
        "inputFiles"
      ],
      "properties": {
        "commitSha": { "type": ["string", "null"] },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "referenceManifestSha256": { "$ref": "#/$defs/sha256" },
        "inputFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "reasoningEffort"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": ["string", "null"] }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "mode",
        "command",
        "exitCode",
        "durationSeconds",
        "threadId",
        "usage",
        "eventCount",
        "unparsedLineCount"
      ],
      "properties": {
        "name": {
          "enum": ["codex-cli", "claude-cli", "grok-cli", "opencode-cli"]
        },
        "version": { "type": ["string", "null"] },
        "mode": { "const": "non-interactive" },
        "command": { "type": "array", "items": { "type": "string" } },
        "exitCode": { "type": ["integer", "null"] },
        "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
        "threadId": { "type": ["string", "null"] },
        "usage": { "type": ["object", "null"] },
        "eventCount": { "type": "integer", "minimum": 0 },
        "unparsedLineCount": { "type": "integer", "minimum": 0 },
        "failureMessage": { "type": ["string", "null"] },
        "retryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "baseDelaySeconds", "maximumDelaySeconds"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "baseDelaySeconds": { "type": "integer", "minimum": 0 },
            "maximumDelaySeconds": { "type": "integer", "minimum": 0 }
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "startedAt",
              "completedAt",
              "exitCode",
              "durationSeconds",
              "timedOut",
              "retryable",
              "failureMessage",
              "outputFileCount",
              "stdout",
              "stderr",
              "outcome"
            ],
            "properties": {
              "number": { "type": "integer", "minimum": 1 },
              "startedAt": { "type": "string", "format": "date-time" },
              "completedAt": { "type": "string", "format": "date-time" },
              "exitCode": { "type": "integer" },
              "durationSeconds": { "type": "number", "minimum": 0 },
              "timedOut": { "type": "boolean" },
              "retryable": { "type": "boolean" },
              "failureMessage": { "type": ["string", "null"] },
              "outputFileCount": { "type": "integer", "minimum": 0 },
              "stdout": { "type": "string" },
              "stderr": { "type": "string" },
              "outcome": {
                "enum": [
                  "success",
                  "transient_failure",
                  "permanent_failure",
                  "model_rejected",
                  "timeout"
                ]
              },
              "retryDelaySeconds": { "type": "integer", "minimum": 0 },
              "archivedOutputs": { "type": "string" },
              "retrySkippedReason": { "type": "string" }
            }
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "toolsEnabled",
        "webEnabled",
        "networkEnabled",
        "duplicateToolEnabled",
        "duplicateToolVersion",
        "duplicateQueryLimit",
        "remoteDuplicateEvaluation",
        "notes"
      ],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "problemCount": { "type": "integer", "minimum": 5, "maximum": 50 },
        "toolsEnabled": { "type": "boolean" },
        "webEnabled": { "type": "boolean" },
        "networkEnabled": { "type": "boolean" },
        "duplicateToolEnabled": { "type": "boolean" },
        "duplicateToolVersion": { "const": 1 },
        "duplicateQueryLimit": { "type": "integer", "minimum": 5 },
        "remoteDuplicateEvaluation": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "stdout",
        "stderr",
        "originalityToolGuide",
        "originalityToolSummary",
        "originalityToolAudit",
        "finalMessage",
        "outputs",
        "automatedEvaluation",
        "humanEvaluation",
        "results"
      ],
      "properties": {
        "task": { "type": "string" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "attempts": { "type": "string" },
        "originalityToolGuide": { "type": "string" },
        "originalityToolSummary": { "type": "string" },
        "originalityToolAudit": { "type": "string" },
        "finalMessage": { "type": "string" },
        "outputs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\.sgf$" }
        },
        "automatedEvaluation": { "type": "string" },
        "humanEvaluation": { "type": "string" },
        "humanReviews": { "type": "string" },
        "results": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
